<?xml version="1.0"?>
<configuration>
    <configSections>
        <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging"/>
    </configSections>

    <Fanex.Logging
    msmqPath="FormatName:DIRECT=tcp:10.18.200.209\private$\entlib"
    defaultCategory="CustomEmailTraceCategory"/>

    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0"/>
    </startup>
</configuration>
